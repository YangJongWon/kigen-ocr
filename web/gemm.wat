;; kigen-ocr SIMD GEMM (MIT License). Built into kigen-ocr.js by tools/build-wasm.mjs.
;;
;; out[O4][P4] = W[O4][K] * col[K][P4] + b[O4], then max(out, floor)
;; floor = 0 (ReLU) when relu != 0, else -inf (no-op). All pointers are byte offsets,
;; 16-byte aligned; O4 and P4 are multiples of 4; K > 0.
;; Tiles: 4 output rows x 8 columns (8 v128 accumulators), then a 4x4 tail.
(module
  (memory (export "mem") 1)
  (func (export "gemm")
    (param $w i32) (param $b i32) (param $O4 i32) (param $K i32)
    (param $col i32) (param $P4 i32) (param $out i32) (param $relu i32)
    (local $o i32) (local $p i32) (local $k i32)
    (local $pw0 i32) (local $pw1 i32) (local $pw2 i32) (local $pw3 i32)
    (local $ci i32) (local $cs i32) (local $ks i32) (local $ob i32) (local $bp i32)
    (local $c0 v128) (local $c1 v128)
    (local $w0 v128) (local $w1 v128) (local $w2 v128) (local $w3 v128)
    (local $a00 v128) (local $a01 v128) (local $a10 v128) (local $a11 v128)
    (local $a20 v128) (local $a21 v128) (local $a30 v128) (local $a31 v128)
    (local $b0 v128) (local $b1 v128) (local $b2 v128) (local $b3 v128)
    (local $floor v128)
    (local.set $cs (i32.shl (local.get $P4) (i32.const 2)))
    (local.set $ks (i32.shl (local.get $K) (i32.const 2)))
    (local.set $floor
      (if (result v128) (local.get $relu)
        (then (f32x4.splat (f32.const 0)))
        (else (f32x4.splat (f32.const -inf)))))
    (local.set $o (i32.const 0))
    (block $odone
      (loop $oloop
        (br_if $odone (i32.ge_u (local.get $o) (local.get $O4)))
        (local.set $bp (i32.add (local.get $b) (i32.shl (local.get $o) (i32.const 2))))
        (local.set $b0 (f32x4.splat (f32.load offset=0 (local.get $bp))))
        (local.set $b1 (f32x4.splat (f32.load offset=4 (local.get $bp))))
        (local.set $b2 (f32x4.splat (f32.load offset=8 (local.get $bp))))
        (local.set $b3 (f32x4.splat (f32.load offset=12 (local.get $bp))))
        (local.set $p (i32.const 0))
        ;; ---- 4 x 8 tiles
        (block $pdone
          (loop $ploop
            (br_if $pdone (i32.gt_u (i32.add (local.get $p) (i32.const 8)) (local.get $P4)))
            (local.set $a00 (v128.const f32x4 0 0 0 0)) (local.set $a01 (v128.const f32x4 0 0 0 0))
            (local.set $a10 (v128.const f32x4 0 0 0 0)) (local.set $a11 (v128.const f32x4 0 0 0 0))
            (local.set $a20 (v128.const f32x4 0 0 0 0)) (local.set $a21 (v128.const f32x4 0 0 0 0))
            (local.set $a30 (v128.const f32x4 0 0 0 0)) (local.set $a31 (v128.const f32x4 0 0 0 0))
            (local.set $pw0 (i32.add (local.get $w) (i32.mul (local.get $o) (local.get $ks))))
            (local.set $pw1 (i32.add (local.get $pw0) (local.get $ks)))
            (local.set $pw2 (i32.add (local.get $pw1) (local.get $ks)))
            (local.set $pw3 (i32.add (local.get $pw2) (local.get $ks)))
            (local.set $ci (i32.add (local.get $col) (i32.shl (local.get $p) (i32.const 2))))
            (local.set $k (local.get $K))
            (loop $kloop
              (local.set $c0 (v128.load offset=0 (local.get $ci)))
              (local.set $c1 (v128.load offset=16 (local.get $ci)))
              (local.set $w0 (f32x4.splat (f32.load (local.get $pw0))))
              (local.set $w1 (f32x4.splat (f32.load (local.get $pw1))))
              (local.set $w2 (f32x4.splat (f32.load (local.get $pw2))))
              (local.set $w3 (f32x4.splat (f32.load (local.get $pw3))))
              (local.set $a00 (f32x4.add (local.get $a00) (f32x4.mul (local.get $w0) (local.get $c0))))
              (local.set $a01 (f32x4.add (local.get $a01) (f32x4.mul (local.get $w0) (local.get $c1))))
              (local.set $a10 (f32x4.add (local.get $a10) (f32x4.mul (local.get $w1) (local.get $c0))))
              (local.set $a11 (f32x4.add (local.get $a11) (f32x4.mul (local.get $w1) (local.get $c1))))
              (local.set $a20 (f32x4.add (local.get $a20) (f32x4.mul (local.get $w2) (local.get $c0))))
              (local.set $a21 (f32x4.add (local.get $a21) (f32x4.mul (local.get $w2) (local.get $c1))))
              (local.set $a30 (f32x4.add (local.get $a30) (f32x4.mul (local.get $w3) (local.get $c0))))
              (local.set $a31 (f32x4.add (local.get $a31) (f32x4.mul (local.get $w3) (local.get $c1))))
              (local.set $pw0 (i32.add (local.get $pw0) (i32.const 4)))
              (local.set $pw1 (i32.add (local.get $pw1) (i32.const 4)))
              (local.set $pw2 (i32.add (local.get $pw2) (i32.const 4)))
              (local.set $pw3 (i32.add (local.get $pw3) (i32.const 4)))
              (local.set $ci (i32.add (local.get $ci) (local.get $cs)))
              (local.set $k (i32.sub (local.get $k) (i32.const 1)))
              (br_if $kloop (local.get $k)))
            (local.set $ob (i32.add (local.get $out)
              (i32.add (i32.mul (local.get $o) (local.get $cs)) (i32.shl (local.get $p) (i32.const 2)))))
            (v128.store offset=0 (local.get $ob) (f32x4.max (f32x4.add (local.get $a00) (local.get $b0)) (local.get $floor)))
            (v128.store offset=16 (local.get $ob) (f32x4.max (f32x4.add (local.get $a01) (local.get $b0)) (local.get $floor)))
            (local.set $ob (i32.add (local.get $ob) (local.get $cs)))
            (v128.store offset=0 (local.get $ob) (f32x4.max (f32x4.add (local.get $a10) (local.get $b1)) (local.get $floor)))
            (v128.store offset=16 (local.get $ob) (f32x4.max (f32x4.add (local.get $a11) (local.get $b1)) (local.get $floor)))
            (local.set $ob (i32.add (local.get $ob) (local.get $cs)))
            (v128.store offset=0 (local.get $ob) (f32x4.max (f32x4.add (local.get $a20) (local.get $b2)) (local.get $floor)))
            (v128.store offset=16 (local.get $ob) (f32x4.max (f32x4.add (local.get $a21) (local.get $b2)) (local.get $floor)))
            (local.set $ob (i32.add (local.get $ob) (local.get $cs)))
            (v128.store offset=0 (local.get $ob) (f32x4.max (f32x4.add (local.get $a30) (local.get $b3)) (local.get $floor)))
            (v128.store offset=16 (local.get $ob) (f32x4.max (f32x4.add (local.get $a31) (local.get $b3)) (local.get $floor)))
            (local.set $p (i32.add (local.get $p) (i32.const 8)))
            (br $ploop)))
        ;; ---- 4 x 4 tail (P4 not a multiple of 8)
        (if (i32.lt_u (local.get $p) (local.get $P4))
          (then
            (local.set $a00 (v128.const f32x4 0 0 0 0)) (local.set $a10 (v128.const f32x4 0 0 0 0))
            (local.set $a20 (v128.const f32x4 0 0 0 0)) (local.set $a30 (v128.const f32x4 0 0 0 0))
            (local.set $pw0 (i32.add (local.get $w) (i32.mul (local.get $o) (local.get $ks))))
            (local.set $pw1 (i32.add (local.get $pw0) (local.get $ks)))
            (local.set $pw2 (i32.add (local.get $pw1) (local.get $ks)))
            (local.set $pw3 (i32.add (local.get $pw2) (local.get $ks)))
            (local.set $ci (i32.add (local.get $col) (i32.shl (local.get $p) (i32.const 2))))
            (local.set $k (local.get $K))
            (loop $kloop4
              (local.set $c0 (v128.load (local.get $ci)))
              (local.set $a00 (f32x4.add (local.get $a00) (f32x4.mul (f32x4.splat (f32.load (local.get $pw0))) (local.get $c0))))
              (local.set $a10 (f32x4.add (local.get $a10) (f32x4.mul (f32x4.splat (f32.load (local.get $pw1))) (local.get $c0))))
              (local.set $a20 (f32x4.add (local.get $a20) (f32x4.mul (f32x4.splat (f32.load (local.get $pw2))) (local.get $c0))))
              (local.set $a30 (f32x4.add (local.get $a30) (f32x4.mul (f32x4.splat (f32.load (local.get $pw3))) (local.get $c0))))
              (local.set $pw0 (i32.add (local.get $pw0) (i32.const 4)))
              (local.set $pw1 (i32.add (local.get $pw1) (i32.const 4)))
              (local.set $pw2 (i32.add (local.get $pw2) (i32.const 4)))
              (local.set $pw3 (i32.add (local.get $pw3) (i32.const 4)))
              (local.set $ci (i32.add (local.get $ci) (local.get $cs)))
              (local.set $k (i32.sub (local.get $k) (i32.const 1)))
              (br_if $kloop4 (local.get $k)))
            (local.set $ob (i32.add (local.get $out)
              (i32.add (i32.mul (local.get $o) (local.get $cs)) (i32.shl (local.get $p) (i32.const 2)))))
            (v128.store (local.get $ob) (f32x4.max (f32x4.add (local.get $a00) (local.get $b0)) (local.get $floor)))
            (local.set $ob (i32.add (local.get $ob) (local.get $cs)))
            (v128.store (local.get $ob) (f32x4.max (f32x4.add (local.get $a10) (local.get $b1)) (local.get $floor)))
            (local.set $ob (i32.add (local.get $ob) (local.get $cs)))
            (v128.store (local.get $ob) (f32x4.max (f32x4.add (local.get $a20) (local.get $b2)) (local.get $floor)))
            (local.set $ob (i32.add (local.get $ob) (local.get $cs)))
            (v128.store (local.get $ob) (f32x4.max (f32x4.add (local.get $a30) (local.get $b3)) (local.get $floor)))))
        (local.set $o (i32.add (local.get $o) (i32.const 4)))
        (br $oloop))))

  ;; ---- int8 weights x int16 activations ------------------------------------------------
  ;; absmax: max |a[i]| over n floats (n multiple of 4; tail padded with zeros by the caller)
  (func (export "absmax") (param $a i32) (param $n i32) (result f32)
    (local $m v128) (local $e i32)
    (local.set $m (v128.const f32x4 0 0 0 0))
    (local.set $e (i32.add (local.get $a) (i32.shl (local.get $n) (i32.const 2))))
    (block $d (loop $l
      (br_if $d (i32.ge_u (local.get $a) (local.get $e)))
      (local.set $m (f32x4.max (local.get $m) (f32x4.abs (v128.load (local.get $a)))))
      (local.set $a (i32.add (local.get $a) (i32.const 16)))
      (br $l)))
    (f32.max (f32.max (f32x4.extract_lane 0 (local.get $m)) (f32x4.extract_lane 1 (local.get $m)))
             (f32.max (f32x4.extract_lane 2 (local.get $m)) (f32x4.extract_lane 3 (local.get $m)))))

  ;; quantpad: inp[C][H][W] f32 -> qin[C][H+2ph][W+2pw] i16, q = round(x * inv), zero border.
  ;; Each activation is quantized once; the padding removes all bounds checks from im2colq.
  (func (export "quantpad")
    (param $inp i32) (param $C i32) (param $H i32) (param $W i32) (param $ph i32) (param $pw i32)
    (param $qin i32) (param $inv f32)
    (local $c i32) (local $y i32) (local $x i32) (local $Wp i32) (local $Hp i32) (local $d i32)
    (local.set $Wp (i32.add (local.get $W) (i32.shl (local.get $pw) (i32.const 1))))
    (local.set $Hp (i32.add (local.get $H) (i32.shl (local.get $ph) (i32.const 1))))
    (memory.fill (local.get $qin) (i32.const 0)
      (i32.shl (i32.mul (i32.mul (local.get $C) (local.get $Hp)) (local.get $Wp)) (i32.const 1)))
    (local.set $c (i32.const 0))
    (block $cd (loop $cl
      (br_if $cd (i32.ge_u (local.get $c) (local.get $C)))
      (local.set $y (i32.const 0))
      (block $yd (loop $yl
        (br_if $yd (i32.ge_u (local.get $y) (local.get $H)))
        (local.set $d (i32.add (local.get $qin) (i32.shl (i32.add
          (i32.mul (i32.add (i32.mul (local.get $c) (local.get $Hp)) (i32.add (local.get $y) (local.get $ph))) (local.get $Wp))
          (local.get $pw)) (i32.const 1))))
        (local.set $x (local.get $W))
        (block $xd (loop $xl
          (br_if $xd (i32.eqz (local.get $x)))
          (i32.store16 (local.get $d)
            (i32.trunc_sat_f32_s (f32.nearest (f32.mul (f32.load (local.get $inp)) (local.get $inv)))))
          (local.set $inp (i32.add (local.get $inp) (i32.const 4)))
          (local.set $d (i32.add (local.get $d) (i32.const 2)))
          (local.set $x (i32.sub (local.get $x) (i32.const 1)))
          (br $xl)))
        (local.set $y (i32.add (local.get $y) (i32.const 1)))
        (br $yl)))
      (local.set $c (i32.add (local.get $c) (i32.const 1)))
      (br $cl))))

  ;; im2colq: qin[C][Hp][Wp] i16 (from quantpad) -> colq[K2/2][P4][2] i16.
  ;; k = (c, i, j) over kh x kw taps, column dilation dil; output (y, x) reads qin[c][y+i][x+j*dil].
  ;; A missing odd tap (K odd) reads the zero row at $zero. 8 columns per step (two loads, two
  ;; interleaving shuffles); the overshoot past Wo is overwritten by the next row / pair, and
  ;; columns P..P4 are zeroed. Needs >= 64 bytes of slack after qin, zero row and colq.
  (func (export "im2colq")
    (param $qin i32) (param $C i32) (param $Hp i32) (param $Wp i32) (param $kh i32) (param $kw i32)
    (param $dil i32) (param $Ho i32) (param $Wo i32) (param $P4 i32) (param $colq i32) (param $zero i32)
    (local $K i32) (local $k i32) (local $y i32) (local $n i32) (local $dst i32) (local $d i32)
    (local $base0 i32) (local $base1 i32) (local $s0 i32) (local $s1 i32) (local $tap i32) (local $end i32)
    (local $a v128) (local $b v128) (local $rs i32) (local $k1 i32)
    (local.set $tap (i32.mul (local.get $kh) (local.get $kw)))
    (local.set $K (i32.mul (local.get $C) (local.get $tap)))
    (local.set $rs (i32.shl (local.get $Wp) (i32.const 1)))
    (local.set $dst (local.get $colq))
    (local.set $k (i32.const 0))
    (block $kd (loop $kl
      (br_if $kd (i32.ge_u (local.get $k) (local.get $K)))
      ;; tap k -> start of qin[c][i][j*dil]
      (local.set $base0 (i32.add (local.get $qin) (i32.shl (i32.add
        (i32.mul (i32.add (i32.mul (i32.div_u (local.get $k) (local.get $tap)) (local.get $Hp))
                          (i32.div_u (i32.rem_u (local.get $k) (local.get $tap)) (local.get $kw))) (local.get $Wp))
        (i32.mul (i32.rem_u (local.get $k) (local.get $kw)) (local.get $dil))) (i32.const 1))))
      (local.set $k1 (i32.add (local.get $k) (i32.const 1)))
      (local.set $base1 (if (result i32) (i32.lt_u (local.get $k1) (local.get $K))
        (then (i32.add (local.get $qin) (i32.shl (i32.add
          (i32.mul (i32.add (i32.mul (i32.div_u (local.get $k1) (local.get $tap)) (local.get $Hp))
                            (i32.div_u (i32.rem_u (local.get $k1) (local.get $tap)) (local.get $kw))) (local.get $Wp))
          (i32.mul (i32.rem_u (local.get $k1) (local.get $kw)) (local.get $dil))) (i32.const 1))))
        (else (i32.const -1))))
      (local.set $end (i32.add (local.get $dst) (i32.shl (local.get $P4) (i32.const 2))))
      (local.set $y (i32.const 0))
      (block $yd (loop $yl
        (br_if $yd (i32.ge_u (local.get $y) (local.get $Ho)))
        (local.set $s0 (i32.add (local.get $base0) (i32.mul (local.get $y) (local.get $rs))))
        (local.set $s1 (if (result i32) (i32.eq (local.get $base1) (i32.const -1))
          (then (local.get $zero))
          (else (i32.add (local.get $base1) (i32.mul (local.get $y) (local.get $rs))))))
        (local.set $d (local.get $dst))
        (local.set $n (local.get $Wo))
        (block $xd (loop $xl
          (br_if $xd (i32.le_s (local.get $n) (i32.const 0)))
          (local.set $a (v128.load (local.get $s0)))
          (local.set $b (v128.load (local.get $s1)))
          (v128.store offset=0 (local.get $d)
            (i8x16.shuffle 0 1 16 17 2 3 18 19 4 5 20 21 6 7 22 23 (local.get $a) (local.get $b)))
          (v128.store offset=16 (local.get $d)
            (i8x16.shuffle 8 9 24 25 10 11 26 27 12 13 28 29 14 15 30 31 (local.get $a) (local.get $b)))
          (local.set $s0 (i32.add (local.get $s0) (i32.const 16)))
          (if (i32.ne (local.get $s1) (local.get $zero))
            (then (local.set $s1 (i32.add (local.get $s1) (i32.const 16)))))
          (local.set $d (i32.add (local.get $d) (i32.const 32)))
          (local.set $n (i32.sub (local.get $n) (i32.const 8)))
          (br $xl)))
        (local.set $dst (i32.add (local.get $dst) (i32.shl (local.get $Wo) (i32.const 2))))
        (local.set $y (i32.add (local.get $y) (i32.const 1)))
        (br $yl)))
      (block $zd (loop $zl
        (br_if $zd (i32.ge_u (local.get $dst) (local.get $end)))
        (i32.store (local.get $dst) (i32.const 0))
        (local.set $dst (i32.add (local.get $dst) (i32.const 4)))
        (br $zl)))
      (local.set $k (i32.add (local.get $k) (i32.const 2)))
      (br $kl))))

  ;; gemm8: out[O4][P4] = (Wq[O4][K2] . colq) * (srow[o] * sa) + b[o], then max(., floor)
  ;; Wq: per row KH = K2/2 i32 words, each two i16 weights (even k low half, odd k high half).
  ;; i32 accumulation is exact: |w| <= 127, |q| <= 4095, K <= 1152 -> |acc| < 6e8.
  (func (export "gemm8")
    (param $w i32) (param $srow i32) (param $sa f32) (param $b i32) (param $O4 i32) (param $KH i32)
    (param $col i32) (param $P4 i32) (param $out i32) (param $relu i32)
    (local $o i32) (local $p i32) (local $k i32)
    (local $pw0 i32) (local $pw1 i32) (local $pw2 i32) (local $pw3 i32)
    (local $ci i32) (local $cs i32) (local $ks i32) (local $ob i32) (local $bp i32)
    (local $c0 v128) (local $c1 v128)
    (local $w0 v128) (local $w1 v128) (local $w2 v128) (local $w3 v128)
    (local $a00 v128) (local $a01 v128) (local $a10 v128) (local $a11 v128)
    (local $a20 v128) (local $a21 v128) (local $a30 v128) (local $a31 v128)
    (local $s0 v128) (local $s1 v128) (local $s2 v128) (local $s3 v128)
    (local $b0 v128) (local $b1 v128) (local $b2 v128) (local $b3 v128)
    (local $floor v128)
    ;; one colq row (k pair) = P4 columns x 2 i16 = P4*4 bytes, same as one f32 out row
    (local.set $cs (i32.shl (local.get $P4) (i32.const 2)))
    (local.set $ks (i32.shl (local.get $KH) (i32.const 2)))
    (local.set $floor
      (if (result v128) (local.get $relu)
        (then (f32x4.splat (f32.const 0)))
        (else (f32x4.splat (f32.const -inf)))))
    (local.set $o (i32.const 0))
    (block $odone
      (loop $oloop
        (br_if $odone (i32.ge_u (local.get $o) (local.get $O4)))
        (local.set $bp (i32.add (local.get $b) (i32.shl (local.get $o) (i32.const 2))))
        (local.set $b0 (f32x4.splat (f32.load offset=0 (local.get $bp))))
        (local.set $b1 (f32x4.splat (f32.load offset=4 (local.get $bp))))
        (local.set $b2 (f32x4.splat (f32.load offset=8 (local.get $bp))))
        (local.set $b3 (f32x4.splat (f32.load offset=12 (local.get $bp))))
        (local.set $bp (i32.add (local.get $srow) (i32.shl (local.get $o) (i32.const 2))))
        (local.set $s0 (f32x4.splat (f32.mul (f32.load offset=0 (local.get $bp)) (local.get $sa))))
        (local.set $s1 (f32x4.splat (f32.mul (f32.load offset=4 (local.get $bp)) (local.get $sa))))
        (local.set $s2 (f32x4.splat (f32.mul (f32.load offset=8 (local.get $bp)) (local.get $sa))))
        (local.set $s3 (f32x4.splat (f32.mul (f32.load offset=12 (local.get $bp)) (local.get $sa))))
        (local.set $p (i32.const 0))
        (block $pdone
          (loop $ploop
